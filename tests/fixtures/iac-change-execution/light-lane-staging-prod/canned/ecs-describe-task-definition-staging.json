{
  "taskDefinition": {
    "taskDefinitionArn": "arn:aws:ecs:ap-southeast-1:222222222222:task-definition/paymentapi-staging:8",
    "family": "paymentapi-staging",
    "revision": 8,
    "status": "ACTIVE",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
      "FARGATE"
    ],
    "cpu": "256",
    "memory": "512",
    "containerDefinitions": [
      {
        "name": "paymentapi",
        "image": "222222222222.dkr.ecr.ap-southeast-1.amazonaws.com/paymentapi:v2.5.0-rc2",
        "essential": true,
        "portMappings": [
          {
            "containerPort": 8080,
            "hostPort": 8080,
            "protocol": "tcp"
          }
        ],
        "environment": [
          {
            "name": "APP_ENV",
            "value": "staging"
          },
          {
            "name": "DB_HOST",
            "value": "paymentapi-staging-db.cluster-c1abcd5678ef.ap-southeast-1.rds.amazonaws.com"
          },
          {
            "name": "PORT",
            "value": "8080"
          }
        ],
        "logConfiguration": {
          "logDriver": "awslogs",
          "options": {
            "awslogs-group": "/ecs/paymentapi-staging",
            "awslogs-region": "ap-southeast-1",
            "awslogs-stream-prefix": "ecs"
          }
        }
      }
    ],
    "executionRoleArn": "arn:aws:iam::222222222222:role/paymentapi-staging-ecs-execution",
    "taskRoleArn": "arn:aws:iam::222222222222:role/paymentapi-staging-ecs-task"
  }
}

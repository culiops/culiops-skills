{
  "taskDefinition": {
    "taskDefinitionArn": "arn:aws:ecs:ap-southeast-1:111111111111:task-definition/paymentapi-dev:7",
    "family": "paymentapi-dev",
    "revision": 7,
    "status": "ACTIVE",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
      "FARGATE"
    ],
    "cpu": "256",
    "memory": "1024",
    "containerDefinitions": [
      {
        "name": "paymentapi",
        "image": "111111111111.dkr.ecr.ap-southeast-1.amazonaws.com/paymentapi:v2.5.0-dev.14",
        "essential": true,
        "portMappings": [
          {
            "containerPort": 8080,
            "hostPort": 8080,
            "protocol": "tcp"
          }
        ],
        "environment": [
          {
            "name": "APP_ENV",
            "value": "dev"
          },
          {
            "name": "DB_HOST",
            "value": "paymentapi-dev-db.cluster-c0dev5678ef.ap-southeast-1.rds.amazonaws.com"
          },
          {
            "name": "PORT",
            "value": "8080"
          }
        ],
        "logConfiguration": {
          "logDriver": "awslogs",
          "options": {
            "awslogs-group": "/ecs/paymentapi-dev",
            "awslogs-region": "ap-southeast-1",
            "awslogs-stream-prefix": "ecs"
          }
        }
      }
    ],
    "executionRoleArn": "arn:aws:iam::111111111111:role/paymentapi-dev-ecs-execution",
    "taskRoleArn": "arn:aws:iam::111111111111:role/paymentapi-dev-ecs-task"
  }
}

{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "monitoring.coreos.com/v1",
      "kind": "ServiceMonitor",
      "metadata": {
        "name": "notifyapi",
        "namespace": "notifyapi-prod"
      },
      "spec": {
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "notifyapi"
          }
        },
        "endpoints": [
          {
            "port": "http",
            "interval": "30s"
          }
        ]
      }
    }
  ]
}
